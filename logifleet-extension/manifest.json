{
  "manifest_version": 3,
  "name": "LogiFleet Driver Sync",
  "version": "1.1.0",
  "description": "Syncs driver records and scrapes compliance data from the MRT admin panel into LogiFleet.",

  "permissions": [
    "activeTab",
    "scripting"
  ],

  "host_permissions": [
    "https://backend.mrt.co.za/*",
    "https://brzrzlsueddmiozybqbr.supabase.co/*"
  ],

  "content_scripts": [
    {
      "matches": ["https://backend.mrt.co.za/admin/drivers*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://backend.mrt.co.za/admin/drivers*"],
      "js": ["compliance-scraper.js"],
      "run_at": "document_idle"
    }
  ]
}
